<Window x:Class="MemPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MemPulse"
        xml:lang="ru-RU" Title="MemPulse" Icon="Assets/MemPulse.png"
        Width="1270" Height="790" MinWidth="1080" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ProcessIconConverter x:Key="ProcessIconConverter"/>
        <LinearGradientBrush x:Key="HeroGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#18343C" Offset="0"/>
            <GradientStop Color="#132631" Offset="0.48"/>
            <GradientStop Color="#101D2B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SideGlow" StartPoint="0,0" EndPoint="0.9,1">
            <GradientStop Color="#102934" Offset="0"/>
            <GradientStop Color="#0C1925" Offset="0.55"/>
            <GradientStop Color="#0B1621" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GraphFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5520CCAF" Offset="0"/>
            <GradientStop Color="#0017B49F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#2D5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#692B39"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#823546"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProcessRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ToolTipService.ShowDuration" Value="6000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D3B48"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22515B"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GroupRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ProcessRowStyle}">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar, still supports normal Windows window dragging. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B1823"
                BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/MemPulse.png" Width="30" Height="30" Stretch="Uniform"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" Text="MemPulse" FontSize="17" FontWeight="Bold" Margin="11,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Margin="14,0,0,0" CornerRadius="8" Background="#153D3B" BorderBrush="#265E5A" BorderThickness="1"
                            VerticalAlignment="Center" Padding="8,4"
                            ToolTip="Мониторинг оперативной памяти активен">
                        <TextBlock Text="●  МОНИТОРИНГ" Foreground="{StaticResource AccentBrush}"
                                   FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Обновления"
                            Style="{StaticResource ActionButton}" MinHeight="32" Padding="13,6" FontSize="12" Margin="0,0,10,0"
                            Click="Update_Click" ToolTip="Проверить наличие новой версии"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="−" Style="{StaticResource TitleButton}" Margin="0,0,2,0"
                            ToolTip="Свернуть" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleButton}" FontSize="13" Margin="0,0,2,0"
                            ToolTip="Развернуть" Click="Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="×" Style="{StaticResource CloseTitleButton}" FontSize="19"
                            ToolTip="Закрыть" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact navigation -->
        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource BorderBrushApp}" Background="{StaticResource SideGlow}">
            <Grid Margin="17,24,17,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource CardLabel}"
                               Margin="11,0,0,15"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource SideButton}"
                            Foreground="{StaticResource AccentBrush}" Background="{StaticResource SelectedNavBrush}"
                            BorderBrush="#2C6B6A" Click="Overview_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,11,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M 1,1 H 6 V 6 H 1 Z M 8,1 H 13 V 6 H 8 Z M 1,8 H 6 V 13 H 1 Z M 8,8 H 13 V 13 H 8 Z"/>
                            <TextBlock Text="Обзор" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProcessesNav" Style="{StaticResource SideButton}" Click="Processes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,11,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1,3 H 13 M 1,7 H 13 M 1,11 H 9"/>
                            <TextBlock Text="Процессы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource SideButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,11,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1,3 H 13 M 1,7 H 13 M 1,11 H 13 M 4,1.5 V 4.5 M 10,5.5 V 8.5 M 5,9.5 V 12.5"/>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutNav" Style="{StaticResource SideButton}" Click="About_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,11,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1 A 6,6 0 1 1 6.99,1 Z M 7,6.5 V 10.5 M 7,4.2 V 4.3"/>
                            <TextBlock Text="О программе" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="ТЕКУЩАЯ ЗАГРУЗКА" Style="{StaticResource CardLabel}" Margin="10,0,0,9"/>
                    <DockPanel Margin="10,0,9,7">
                        <TextBlock x:Name="SideUsageText" Text="—" FontSize="23" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left"/>
                        <TextBlock Text="ОЗУ" Style="{StaticResource MutedText}" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right" Margin="0,0,0,4"/>
                    </DockPanel>
                    <ProgressBar x:Name="SideUsageBar" Height="5" Minimum="0" Maximum="100"
                                 Margin="10,0,9,15"/>
                    <Border Height="1" Background="{StaticResource BorderBrushApp}" Margin="9,0,9,16"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" x:Name="VersionText" Text="MemPulse" FontSize="12"
                               FontWeight="SemiBold" Margin="10,0,0,5"/>
                    <TextBlock Text="Мониторинг памяти Windows" Style="{StaticResource MutedText}"
                               FontSize="10" TextWrapping="Wrap" Margin="10,0,3,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
<Grid x:Name="OverviewPage" Margin="22,19,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="272"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="294"/>
            </Grid.ColumnDefinitions>

            <!-- Memory visual and actual rolling history -->
            <Border x:Name="OverviewCard" Grid.Row="0" Grid.Column="0"
                    Background="{StaticResource HeroGlow}" CornerRadius="16"
                    BorderBrush="#27434D" BorderThickness="1">
                <Grid Margin="22,19,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource CardLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="В реальном времени" Style="{StaticResource MutedText}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="186"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="166" Height="166" HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                            <Ellipse Width="162" Height="162" Fill="#162E36" Opacity="0.68"/>
                            <Ellipse Width="148" Height="148" Stroke="#284954" StrokeThickness="11"/>
                            <Path x:Name="UsageArc" Width="166" Height="166" Stroke="#35E0C2"
                                  StrokeThickness="11" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" SnapsToDevicePixels="True"/>
                            <Ellipse x:Name="FullUsageRing" Width="148" Height="148" Stroke="#FF737D"
                                     StrokeThickness="11" Visibility="Collapsed"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,-3,0,0">
                                <TextBlock Foreground="{StaticResource TextBrush}" x:Name="PercentText" Text="—" FontSize="38"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="ЗАНЯТО" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Foreground="{StaticResource TextBrush}" x:Name="UsedText" Text="—" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ИСТОРИЯ ЗАГРУЗКИ" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="6" Background="#152E3A" Padding="7,2">
                                    <TextBlock x:Name="HistoryRangeText" Text="—"
                                               Style="{StaticResource MutedText}" FontSize="10"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" CornerRadius="8" Background="#0F2632"
                                    BorderBrush="#274754" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#1C3743" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="1" BorderBrush="#1C3743" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="2" BorderBrush="#1C3743" BorderThickness="0,0,0,1"/>
                                    <Canvas x:Name="HistoryCanvas" Grid.RowSpan="4" ClipToBounds="True"
                                            SizeChanged="HistoryCanvas_SizeChanged">
                                        <Polygon x:Name="HistoryFill" Fill="{StaticResource GraphFill}"/>
                                        <Polyline x:Name="HistoryLine" Stroke="#46E7CB"
                                                  StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="HistoryDot" Width="7" Height="7"
                                                 Fill="#46E7CB" Stroke="#0C202B" StrokeThickness="1.3"
                                                 Visibility="Collapsed"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ДОСТУПНО" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Foreground="{StaticResource TextBrush}" x:Name="AvailableText" Text="—" FontSize="17"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ВСЕГО" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Foreground="{StaticResource TextBrush}" x:Name="TotalText" Text="—" FontSize="17"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Cleanup controls -->
            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource PanelBrush}"
                    CornerRadius="16" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1">
                <Grid Margin="18,17,18,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource TextBrush}" Text="Очистка памяти" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Выберите нужные операции" Style="{StaticResource MutedText}"
                               Margin="0,5,0,6"/>
                    <StackPanel Grid.Row="2">
                        <CheckBox x:Name="StandbyCheck" IsChecked="True" Margin="0,8,0,0"
                                  ToolTip="Освобождает standby-страницы. При повторном обращении к данным возможна дополнительная нагрузка на диск.">
                            <StackPanel>
                                <TextBlock Text="Кэш ожидания" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Безопасно освобождает неиспользуемый кэш" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="WorkingCheck" Margin="0,11,0,0"
                                  ToolTip="Уменьшает рабочие наборы процессов. Может временно замедлить приложения.">
                            <StackPanel>
                                <TextBlock Text="Рабочие наборы" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Сжимает память активных приложений" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ModifiedCheck" Margin="0,11,0,0"
                                  ToolTip="Дополнительная операция: может вызвать запись на диск.">
                            <StackPanel>
                                <TextBlock Text="Изменённые страницы" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Сбрасывает буферы на диск перед очисткой" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Button x:Name="CleanButton" Content="⚡  Очистить выбранное"
                                Style="{StaticResource PrimaryButton}" Height="44" MinHeight="44" Click="Clean_Click"/>
                        <Button x:Name="ElevateButton" Content="Запустить от администратора"
                                Style="{StaticResource ActionButton}" Padding="8,6"
                                Margin="0,7,0,0" Click="Elevate_Click" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Processes -->
            <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="16">
                <Grid Margin="14,16,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextBrush}" Text="Приложения" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProcessCountText" Text="Получение списка процессов…"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻  Обновить" Style="{StaticResource ActionButton}"
                                Click="Refresh_Click" Padding="12,8" VerticalAlignment="Center" ToolTip="Обновить показатели сейчас (F5)"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="4,0,4,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="36" Padding="34,0,10,0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Поиск по имени процесса или PID (Ctrl+F)"/>
                        <Path IsHitTestVisible="False" Width="13" Height="13" Margin="12,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5.5,0 A 5.5,5.5 0 1 1 5.49,0 Z M 9.5,9.5 L 13,13"/>
                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
                                   Text="Поиск приложения или PID" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="35,0,0,0"/>
                        <Button x:Name="ClearOverviewSearchButton" Grid.Column="1" Content="Сбросить" Visibility="Collapsed"
                                Margin="9,0,0,0" Padding="12,6" Style="{StaticResource ActionButton}"
                                Click="ClearOverviewSearch_Click" ToolTip="Очистить поиск приложений"/>
                    </Grid>
                    <DataGrid x:Name="ProcessGrid" Background="{StaticResource PanelBrush}" Grid.Row="2" AutoGenerateColumns="False"
                              SelectionChanged="ProcessGrid_SelectionChanged" Sorting="ProcessGrid_Sorting" RowHeaderWidth="0"
                              ContextMenuOpening="ProcessGrid_ContextMenuOpening"
                              AlternationCount="2" ScrollViewer.CanContentScroll="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              RowStyle="{StaticResource ProcessRowStyle}" RowHeight="49"
                              ColumnHeaderHeight="39">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="OverviewExcludeMenuItem" Header="Добавить в исключения" Click="ToggleExcludeOverview_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ПРОЦЕСС" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Нажмите для сортировки по имени приложения"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="31"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="27" Height="27" HorizontalAlignment="Left"
                                                  VerticalAlignment="Center">
                                                <Border CornerRadius="8" Background="#25424B">
                                                    <TextBlock Text="{Binding Monogram}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#88DCCF" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                                <Image Source="{Binding IconBytes, Converter={StaticResource ProcessIconConverter}}"
                                                       Width="21" Height="21" Stretch="Uniform"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <TextBlock Foreground="{StaticResource TextBrush}" Grid.Column="1" Text="{Binding DisplayName}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ШТ." Binding="{Binding CountText}" SortMemberPath="Count" Width="66">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Количество процессов (PID) в группе"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="ОЗУ" Width="115" SortMemberPath="WorkingBytes">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Рабочий набор (Working Set) — физическая ОЗУ"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,2,5,2"
                                                    ToolTip="Полоса — относительная нагрузка среди процессов">
                                            <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding WorkingText}" FontSize="12" FontWeight="SemiBold"/>
                                            <ProgressBar Minimum="0" Maximum="100" Height="3"
                                                         Margin="0,6,0,0" Value="{Binding RelativeLoad}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ЧАСТНАЯ" Binding="{Binding PrivateText}" SortMemberPath="PrivateBytes" Width="103">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Частная память (Private Bytes) без общих страниц"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="4,10,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сумма по экземплярам · отдельные PID во вкладке «Процессы»"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="TrimButton" Grid.Column="1" Content="Очистить процесс"
                                Style="{StaticResource ActionButton}" Padding="11,7"
                                IsEnabled="False" Click="Trim_Click"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Уменьшает рабочий набор одиночного процесса. Для групп выберите PID во вкладке «Процессы»."/>
                    </Grid>
                </Grid>
            </Border>

            <!-- One cohesive information card instead of two uneven blocks. -->
            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource PanelBrush}"
                    CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrushApp}">
                <Grid Margin="19,18,19,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource TextBrush}" Text="Показатели памяти" FontSize="16" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="Системный файловый кэш Windows, доступный для быстрого повторного чтения">
                            <TextBlock Text="СИСТЕМНЫЙ КЭШ" Style="{StaticResource CardLabel}"/>
                            <TextBlock Foreground="{StaticResource TextBrush}" x:Name="CacheText" Text="—" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" ToolTip="Объём виртуальной памяти, зарезервированный процессами и системой">
                            <TextBlock Text="ВЫДЕЛЕНО" Style="{StaticResource CardLabel}"/>
                            <TextBlock Foreground="{StaticResource TextBrush}" x:Name="CommitText" Text="—" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,17,0,0"
                                    ToolTip="Предел выделения (ОЗУ + файл подкачки)">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ЛИМИТ ВЫДЕЛЕНИЯ" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="LimitText" Text="—" HorizontalAlignment="Right"
                                           DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                            </DockPanel>
                            <ProgressBar x:Name="CommitBar" Height="5" Minimum="0"
                                         Maximum="100" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PageFileText" Text="Файл подкачки: —"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrushApp}"
                            Margin="0,16,0,14"/>
                    <StackPanel Grid.Row="3" VerticalAlignment="Top">
                        <TextBlock Text="ПОСЛЕДНИЕ ОЧИСТКИ" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="CleanupHistoryText" Text="Очисток в этой сессии ещё не было."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource TextBrush}" Text="Автоочистка" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="AutoCleanBadge" Grid.Column="1" CornerRadius="8" Background="#19343E"
                                    BorderBrush="#294A57" BorderThickness="1" VerticalAlignment="Center" Padding="9,4">
                                <TextBlock x:Name="AutoCleanStateText" Text="Отключена"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="AutoCleanThresholdText" Grid.Row="1"
                                   Text="Порог: 90% · пауза: 15 мин."
                                   Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                        <Button Grid.Row="2" Content="Изменить настройки" Click="Settings_Click"
                                Style="{StaticResource ActionButton}" Padding="10,9"
                                Margin="0,15,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<Grid x:Name="ProcessesPage" Grid.Row="0" Visibility="Collapsed" Margin="22,19,22,18">
 <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="16" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="↻  Обновить" Click="Refresh_Click" Style="{StaticResource ActionButton}" Padding="14,10" ToolTip="Обновить список процессов (F5)"/>
    <StackPanel><TextBlock Foreground="{StaticResource TextBrush}" Text="Приложения и процессы" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock x:Name="GroupCountText" Text="Загрузка…" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,17,0,15">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBox x:Name="GroupSearchBox" Height="38" Padding="34,0,10,0" VerticalContentAlignment="Center" TextChanged="GroupSearch_TextChanged" ToolTip="Поиск по имени или PID (Ctrl+F)"/>
    <Path IsHitTestVisible="False" Width="13" Height="13" Margin="12,0,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Data="M 5.5,0 A 5.5,5.5 0 1 1 5.49,0 Z M 9.5,9.5 L 13,13"/>
    <TextBlock x:Name="GroupSearchPlaceholder" Text="Поиск по имени или PID" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="35,0,0,0"/>
    <Button x:Name="ClearGroupSearchButton" Grid.Column="1" Content="Сбросить" Visibility="Collapsed"
            Margin="9,0,0,0" Padding="12,6" Style="{StaticResource ActionButton}"
            Click="ClearGroupSearch_Click" ToolTip="Очистить поиск процессов"/>
    <TextBlock Grid.Column="2" Text="Сортировка:" Foreground="{StaticResource MutedBrush}" FontSize="12"
               VerticalAlignment="Center" Margin="14,0,8,0"/>
    <ComboBox x:Name="GroupSortCombo" Grid.Column="3" Width="210" Height="38"
              SelectionChanged="GroupSortCombo_SelectionChanged"
              ToolTip="Выберите поле и направление сортировки"/>
   </Grid>
   <DataGrid x:Name="GroupGrid" Grid.Row="2" AutoGenerateColumns="False" RowHeaderWidth="0" RowHeight="49"
             Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
             ContextMenuOpening="GroupGrid_ContextMenuOpening"
             Sorting="GroupGrid_Sorting"
             PreviewMouseLeftButtonDown="GroupGrid_PreviewMouseLeftButtonDown"
             PreviewKeyDown="GroupGrid_PreviewKeyDown"
             RowStyle="{StaticResource GroupRowStyle}" RowDetailsVisibilityMode="VisibleWhenSelected"
             ColumnHeaderHeight="38" ScrollViewer.CanContentScroll="True"
             EnableRowVirtualization="True" EnableColumnVirtualization="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.IsDeferredScrollingEnabled="True">
    <DataGrid.ContextMenu>
     <ContextMenu>
      <MenuItem x:Name="DetailExcludeMenuItem" Header="Добавить в исключения" Click="ToggleExcludeDetail_Click"/>
     </ContextMenu>
    </DataGrid.ContextMenu>
    <DataGrid.RowDetailsTemplate>
     <DataTemplate>
      <Border Background="#132734" Padding="18,12,14,12" Margin="0" BorderBrush="#2E5461" BorderThickness="0,1,0,1" Cursor="Arrow">
       <StackPanel>
        <Grid Margin="0,0,0,10">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="3" Height="13" CornerRadius="1.5" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="ОТДЕЛЬНЫЕ ПРОЦЕССЫ" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="  ·  по убыванию ОЗУ ↓" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
         </StackPanel>
         <Button Grid.Column="1" Content="▲  Свернуть" Click="CollapseGroup_Click"
                 Style="{StaticResource ActionButton}" MinHeight="26" Padding="10,4" FontSize="11"
                 ToolTip="Свернуть список процессов (Esc или повторный клик по строке)"/>
        </Grid>
        <Grid Margin="0,0,12,4">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="95"/>
          <ColumnDefinition Width="115"/>
          <ColumnDefinition Width="115"/>
          <ColumnDefinition Width="130"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="ПРОЦЕСС" Style="{StaticResource CardLabel}" Margin="8,0"/>
         <TextBlock Text="PID" Style="{StaticResource CardLabel}" Grid.Column="1"/>
         <TextBlock Text="ОЗУ" Style="{StaticResource CardLabel}" Grid.Column="2"/>
         <TextBlock Text="ЧАСТНАЯ" Style="{StaticResource CardLabel}" Grid.Column="3"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="342" Background="Transparent">
         <ItemsControl ItemsSource="{Binding Members}">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border BorderBrush="#1C3644" BorderThickness="0,0,0,1">
            <Grid Height="38" Background="Transparent">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="95"/>
              <ColumnDefinition Width="115"/>
              <ColumnDefinition Width="115"/>
              <ColumnDefinition Width="130"/>
             </Grid.ColumnDefinitions>
             <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
             <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Pid}" Grid.Column="1" VerticalAlignment="Center"/>
             <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding WorkingText}" FontWeight="SemiBold" Grid.Column="2" VerticalAlignment="Center"/>
             <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding PrivateText}" Grid.Column="3" VerticalAlignment="Center"/>
             <Button Grid.Column="4" Content="Очистить PID" Tag="{Binding}" Click="TrimMember_Click"
                     Style="{StaticResource ActionButton}" MinHeight="28" Padding="9,4" FontSize="11" Margin="0,4,8,4"/>
            </Grid>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
       </StackPanel>
      </Border>
     </DataTemplate>
    </DataGrid.RowDetailsTemplate>
    <DataGrid.Columns>
     <DataGridTemplateColumn x:Name="DetailNameColumn" Header="ПРИЛОЖЕНИЕ" Width="*" SortMemberPath="Name">
      <DataGridTemplateColumn.HeaderStyle>
       <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="ToolTip" Value="Нажмите на строку, чтобы раскрыть или свернуть процессы; нажмите на заголовок для сортировки по имени"/>
       </Style>
      </DataGridTemplateColumn.HeaderStyle>
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Path x:Name="ExpandChevron"
               Width="6" Height="10"
               Margin="0,0,10,0"
               VerticalAlignment="Center"
               Stretch="Uniform"
               Data="M 0,0 L 4.5,4.5 L 0,9"
               Stroke="{StaticResource MutedBrush}"
               StrokeThickness="1.7"
               StrokeStartLineCap="Round"
               StrokeEndLineCap="Round"
               StrokeLineJoin="Round"
               RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
           <RotateTransform Angle="0"/>
          </Path.RenderTransform>
         </Path>
         <Grid Width="27" Height="27" Margin="0,0,11,0">
          <Border CornerRadius="7" Background="#25424B"><TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/></Border>
          <Image Width="22" Height="22" Source="{Binding IconBytes, Converter={StaticResource ProcessIconConverter}}"/>
         </Grid>
         <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
          <Setter TargetName="ExpandChevron" Property="Stroke" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="ExpandChevron" Property="RenderTransform">
           <Setter.Value>
            <RotateTransform Angle="90"/>
           </Setter.Value>
          </Setter>
         </DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn x:Name="DetailCountColumn" Header="ПРОЦЕССОВ" Binding="{Binding CountText}" SortMemberPath="Count" Width="115">
      <DataGridTextColumn.HeaderStyle>
       <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="ToolTip" Value="Количество процессов (PID) в группе приложения"/>
       </Style>
      </DataGridTextColumn.HeaderStyle>
     </DataGridTextColumn>
     <DataGridTemplateColumn x:Name="DetailWorkingColumn" Header="ОЗУ" SortMemberPath="WorkingBytes" Width="130">
      <DataGridTemplateColumn.HeaderStyle>
       <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="ToolTip" Value="Рабочий набор (Working Set) — физическая ОЗУ, включая общие страницы"/>
       </Style>
      </DataGridTemplateColumn.HeaderStyle>
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <StackPanel VerticalAlignment="Center" Margin="0,2,5,2"
                    ToolTip="Полоса — относительная нагрузка среди приложений">
         <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding WorkingText}" FontSize="12" FontWeight="SemiBold"/>
         <ProgressBar Minimum="0" Maximum="100" Height="3" Margin="0,6,0,0" Value="{Binding RelativeLoad}"/>
        </StackPanel>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn x:Name="DetailPrivateColumn" Header="ЧАСТНАЯ" Binding="{Binding PrivateText}" SortMemberPath="PrivateBytes" Width="135">
      <DataGridTextColumn.HeaderStyle>
       <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="ToolTip" Value="Частная память (Private Bytes) — память, выделенная исключительно процессам этой группы"/>
       </Style>
      </DataGridTextColumn.HeaderStyle>
     </DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="3" Text="Нажмите на строку для раскрытия или сворачивания PID · Сортировка меняется сверху или кликом по столбцу · Суммарная ОЗУ может учитывать общие страницы несколько раз." Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Border>
</Grid>
<Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="22,19,22,18">
 <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="16" Padding="24,20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Foreground="{StaticResource TextBrush}" Text="Настройки" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Мониторинг, автоочистка, исключения и поведение в Windows" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
   <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1060">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <Border Padding="20" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <TextBlock Foreground="{StaticResource TextBrush}" Text="Мониторинг" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Foreground="{StaticResource TextBrush}" Text="Интервал обновления, сек."/>
          <TextBlock Text="Допустимо от 1 до 10 секунд" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
         </StackPanel>
         <TextBox x:Name="RefreshText" Grid.Column="1" TextAlignment="Center" MaxLength="2"/>
        </Grid>
       </StackPanel>
      </Border>
      <Border Padding="20" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Margin="0,15,0,0">
       <StackPanel>
        <TextBlock Foreground="{StaticResource TextBrush}" Text="Автоочистка" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="AutoCleanCheck" Content="Очищать кэш ожидания автоматически" Checked="AutoCleanCheck_Changed" Unchecked="AutoCleanCheck_Changed" Margin="0,0,0,14"/>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Foreground="{StaticResource TextBrush}" Text="Порог ОЗУ, %"/>
          <TextBlock Text="Срабатывает при загрузке 70–98%" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
         </StackPanel>
         <TextBox x:Name="ThresholdText" Grid.Column="1" TextAlignment="Center" MaxLength="2"/>
        </Grid>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Foreground="{StaticResource TextBrush}" Text="Пауза, мин."/>
          <TextBlock Text="Минимальный интервал 5–120 мин." Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
         </StackPanel>
         <TextBox x:Name="CooldownText" Grid.Column="1" TextAlignment="Center" MaxLength="3"/>
        </Grid>
        <CheckBox x:Name="SkipFullscreenCheck" Content="Не запускать в полноэкранном режиме" Margin="0,14,0,0" ToolTip="Пропускать автоочистку во время игр и полноэкранного видео"/>
        <TextBlock x:Name="AutoCleanElevationHint" Text="Автоочистка выполняется только с правами администратора." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,13,0,0" LineHeight="17"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Padding="20" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <TextBlock Foreground="{StaticResource TextBrush}" Text="Windows и трей" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows"/>
        <CheckBox x:Name="MinimizeCheck" Content="Сворачивать в трей"/>
        <CheckBox x:Name="CloseCheck" Content="При закрытии скрывать в трей"/>
        <CheckBox x:Name="HotkeyCheck" Content="Горячая клавиша Ctrl+Alt+M для очистки"/>
       </StackPanel>
      </Border>
      <Border Padding="20" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Margin="0,15,0,0">
       <StackPanel>
        <TextBlock Foreground="{StaticResource TextBrush}" Text="Обновления" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="UpdateCheck" Content="Автоматически проверять обновления"/>
       </StackPanel>
      </Border>
      <Border Padding="20" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12" Margin="0,15,0,0">
       <StackPanel>
        <TextBlock Foreground="{StaticResource TextBrush}" Text="Исключения процессов" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Процессы через запятую (например, game, reaper, chrome), которые пропускаются при очистке рабочих наборов:" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="17"/>
        <TextBox x:Name="ExcludedProcessesText" MinHeight="76" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="0,1,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SettingsStatusText" Text="Изменения вступят в силу после сохранения." Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="Отменить изменения" Click="CancelSettings_Click" Style="{StaticResource ActionButton}" Padding="14,9" Margin="0,0,11,0"/>
      <Button Content="Сохранить" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Padding="20,9"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Grid>
<Grid x:Name="AboutPage" Visibility="Collapsed" Margin="22,19,22,18">
 <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="16" Padding="26,24">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel MaxWidth="980">
    <DockPanel LastChildFill="False">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <Border Width="68" Height="68" CornerRadius="14" Background="#152C38" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" Margin="0,0,18,0">
       <Image Source="Assets/MemPulse.png" Width="50" Height="50" Stretch="Uniform"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <TextBlock Foreground="{StaticResource TextBrush}" Text="MemPulse" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Margin="12,0,0,0" CornerRadius="7" Background="#153D3B" BorderBrush="#265E5A" BorderThickness="1" Padding="8,3" VerticalAlignment="Center">
         <TextBlock Text="MIT · Open Source" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
        </Border>
       </StackPanel>
       <TextBlock x:Name="AboutVersionText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,0"/>
      </StackPanel>
     </StackPanel>
    </DockPanel>
    <TextBlock Foreground="{StaticResource TextBrush}" Text="Прозрачный мониторинг и аккуратная очистка памяти Windows" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,0"/>
    <TextBlock Text="MemPulse отслеживает загрузку ОЗУ в реальном времени, группирует процессы по приложениям и позволяет безопасно освобождать неиспользуемую память." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" LineHeight="20"/>
    <Grid Margin="0,20,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Padding="18" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12">
      <StackPanel>
       <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource CardLabel}" Foreground="{StaticResource AccentBrush}"/>
       <TextBlock Text="Ctrl + Alt + M — быстрая очистка памяти" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock Text="Ctrl + F — перейти к поиску процессов" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="F5 — обновить показатели сейчас" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock Text="Esc — очистить поиск или свернуть группу" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Padding="18" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12">
      <StackPanel>
       <TextBlock Text="КАК РАБОТАЕТ ОЧИСТКА" Style="{StaticResource CardLabel}" Foreground="{StaticResource AccentBrush}"/>
       <TextBlock Text="Кэш ожидания (Standby) безопасен для большинства сценариев и освобождает кэшированные страницы." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"/>
       <TextBlock Text="Принудительная очистка не увеличивает физическую ОЗУ и не ускоряет систему без нехватки памяти." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="4" Padding="18" Background="#172B37" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="12">
      <StackPanel>
       <TextBlock Text="ПРИВАТНОСТЬ И ДИАГНОСТИКА" Style="{StaticResource CardLabel}" Foreground="{StaticResource AccentBrush}"/>
       <TextBlock Text="Программа не собирает телеметрию и работает полностью локально. Сеть используется только для проверки обновлений на GitHub." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"/>
       <TextBlock Text="Журналы запуска и ошибки сохраняются в локальной папке пользователя." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
     <Button Content="GitHub проекта" Click="OpenGithub_Click" Style="{StaticResource PrimaryButton}" Padding="17,11" Margin="0,0,12,0"/>
     <Button Content="Открыть журналы" Click="OpenLogs_Click" Style="{StaticResource ActionButton}" Padding="17,11"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Border>
</Grid>

</Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#0A1720"
                BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#23DBB7" Width="7" Height="7" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="UpdateText" Grid.Column="1" Text="—"
                           Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- Confirmations use the same theme as the rest of the app. -->
        <Grid x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
              Grid.ColumnSpan="2" Panel.ZIndex="100" Visibility="Collapsed"
              Background="#BE050D15">
            <Border Background="#152935" CornerRadius="15" BorderThickness="1"
                    BorderBrush="#315360" Padding="27,24" MaxWidth="530"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="460">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#193C40" BorderBrush="#2D6A68" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="!" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource TextBrush}" x:Name="ConfirmTitle" Text="Подтверждение" FontSize="19"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ConfirmDescription" Grid.Row="1" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20"
                               Margin="0,14,0,24"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancelButton" Content="Отмена"
                                Style="{StaticResource ActionButton}" Padding="17,10" Margin="0,0,10,0"
                                Click="ConfirmNo_Click"/>
                        <Button x:Name="ConfirmAcceptButton" Content="Продолжить"
                                Style="{StaticResource PrimaryButton}" Padding="18,10"
                                Click="ConfirmYes_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>