<Window x:Class="MemPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MemPulse" Width="1050" Height="720" MinWidth="860" MinHeight="570"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="59"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="37"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111A25" BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="M" Foreground="#0C2225" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MemPulse" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="SYSTEM MEMORY" Style="{StaticResource MutedText}" FontSize="10"/>
                    </StackPanel>
                    <Border Margin="18,0,0,0" Padding="8,3" CornerRadius="5" Background="#1E3A38" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Check updates" Style="{StaticResource ActionButton}"
                            Padding="13,8" Margin="0,0,8,0" Click="Update_Click"
                            ToolTip="Check GitHub Releases for a newer version"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Settings" Style="{StaticResource ActionButton}" Padding="13,8"
                            Margin="0,0,12,0" Click="Settings_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="−" Style="{StaticResource TitleButton}" ToolTip="Minimize"
                            Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="×" Style="{StaticResource TitleButton}" ToolTip="Close" FontSize="20"
                            Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,22,22,20">
                        <TextBlock Text="PHYSICAL MEMORY" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,10,0,6" LastChildFill="False">
                            <TextBlock x:Name="UsedText" Text="—" FontSize="31" FontWeight="Bold"
                                       DockPanel.Dock="Left" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="PercentText" Text="—" Foreground="{StaticResource AccentBrush}"
                                       FontSize="19" FontWeight="SemiBold" Margin="12,0,0,3"
                                       VerticalAlignment="Bottom" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="TotalText" Text="Reading system memory…"
                                   Style="{StaticResource MutedText}" Margin="0,9,0,0"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,17">
                                <TextBlock Text="Available" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="AvailableText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,17">
                                <TextBlock Text="System cache" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="CacheText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Committed" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="CommitText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Commit limit" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LimitText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" Text="—"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="0,1,0,0"
                                Margin="0,24,0,20"/>
                        <TextBlock Text="MEMORY CLEANUP" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <CheckBox x:Name="StandbyCheck" Content="Standby cache" IsChecked="True"
                                  Margin="0,14,0,0" ToolTip="Purges cached standby pages. May increase future disk I/O."/>
                        <CheckBox x:Name="WorkingCheck" Content="System working sets"
                                  ToolTip="Trims process working sets. Can cause paging and slowdown."/>
                        <CheckBox x:Name="ModifiedCheck" Content="Modified page list"
                                  ToolTip="Advanced: may trigger disk writes and system stalls."/>
                        <Button x:Name="CleanButton" Content="Clean selected memory" Style="{StaticResource PrimaryButton}"
                                Height="43" Margin="0,20,0,0" Click="Clean_Click"/>
                        <Button x:Name="ElevateButton" Content="Restart as administrator"
                                Style="{StaticResource ActionButton}" Margin="0,9,0,0" Click="Elevate_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,17,18,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Processes" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProcessCountText" Text="Loading processes…"
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Refresh" Style="{StaticResource ActionButton}"
                                    Padding="12,7" Margin="0,0,8,0" Click="Refresh_Click"/>
                            <Button x:Name="TrimButton" Content="Trim selected"
                                    Style="{StaticResource ActionButton}" Padding="12,7"
                                    IsEnabled="False" Click="Trim_Click"
                                    ToolTip="Trim only the selected process working set."/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="6,0,6,12">
                            <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" ToolTip="Search by process name or PID"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search processes or PID"
                                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <DataGrid x:Name="ProcessGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  SelectionChanged="ProcessGrid_SelectionChanged"
                                  ScrollViewer.CanContentScroll="True" RowHeaderWidth="0"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="*"
                                                    SortMemberPath="Name"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="RAM" Binding="{Binding WorkingText}" Width="105"
                                                    SortMemberPath="WorkingBytes"/>
                                <DataGridTextColumn Header="PRIVATE" Binding="{Binding PrivateText}" Width="105"
                                                    SortMemberPath="PrivateBytes"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushApp}"
                            BorderThickness="0,1,0,0" Margin="17,8,17,0">
                        <TextBlock Text="RAM = physical working set  •  Private = private committed memory"
                                   Style="{StaticResource MutedText}" Margin="0,12,0,13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111A25" BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="UpdateText" Grid.Column="1" Text="—"
                           Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
