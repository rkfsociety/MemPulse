<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MemPulse</AssemblyName>
    <RootNamespace>MemPulse</RootNamespace>
    <Version>0.2.24</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>MemPulse.Program</StartupObject>
    <ApplicationIcon>Assets\MemPulse.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <Resource Include="Assets\MemPulse.ico" />
    <Resource Include="Assets\MemPulse.png" />
  </ItemGroup>
</Project>
