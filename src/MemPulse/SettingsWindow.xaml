<Window x:Class="MemPulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="ru-RU" Title="Настройки MemPulse" Icon="Assets/MemPulse.png" Width="492" Height="605" MinWidth="460" MinHeight="555"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource WindowBrush}">
    <Grid Margin="27,23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Мониторинг, автоочистка и запуск" Style="{StaticResource MutedText}"
                       Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="МОНИТОРИНГ" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <Grid Margin="0,12,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Интервал обновления (сек.)" VerticalAlignment="Center"/>
                    <TextBox x:Name="RefreshText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushApp}" Margin="0,0,0,17"/>
                <TextBlock Text="АВТООЧИСТКА" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="AutoCleanCheck" Content="Автоматически очищать кэш ожидания"
                          Margin="0,14,0,8"/>
                <Grid Margin="0,10,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Порог использования ОЗУ (%)" VerticalAlignment="Center"/>
                    <TextBox x:Name="ThresholdText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Пауза между очистками (мин.)" VerticalAlignment="Center"/>
                    <TextBox x:Name="CooldownText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <TextBlock Text="Автоочистка требует прав администратора и не затрагивает изменённые страницы или рабочие наборы процессов."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,19"/>
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushApp}" Margin="0,0,0,17"/>
                <TextBlock Text="WINDOWS И ТРЕЙ" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows" Margin="0,13,0,0"/>
                <CheckBox x:Name="MinimizeCheck" Content="Сворачивать в трей"/>
                <CheckBox x:Name="CloseCheck" Content="При закрытии скрывать в трей"/>
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushApp}" Margin="0,18,0,17"/>
                <TextBlock Text="ОБНОВЛЕНИЯ" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="UpdateCheck" Content="Автоматически проверять обновления"
                          Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
            <Button Content="Отмена" Style="{StaticResource ActionButton}" Width="100" Margin="0,0,9,0"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="140"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
