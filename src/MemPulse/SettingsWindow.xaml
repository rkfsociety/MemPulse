<Window x:Class="MemPulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemPulse settings" Width="470" Height="590" MinWidth="440" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Preferences" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Monitoring, automation and startup" Style="{StaticResource MutedText}"
                       Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="MONITORING" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <Grid Margin="0,12,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Refresh interval (seconds)" VerticalAlignment="Center"/>
                    <TextBox x:Name="RefreshText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushApp}" Margin="0,0,0,17"/>
                <TextBlock Text="AUTOMATIC CLEANUP" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="AutoCleanCheck" Content="Enable automatic standby cache cleanup"
                          Margin="0,14,0,8"/>
                <Grid Margin="0,10,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="RAM usage threshold (%)" VerticalAlignment="Center"/>
                    <TextBox x:Name="ThresholdText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum cooldown (minutes)" VerticalAlignment="Center"/>
                    <TextBox x:Name="CooldownText" Grid.Column="1" TextAlignment="Center"/>
                </Grid>
                <TextBlock Text="Auto-clean only runs with administrator privileges and never flushes modified pages or trims working sets."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,19"/>
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushApp}" Margin="0,0,0,17"/>
                <TextBlock Text="WINDOWS &amp; TRAY" Style="{StaticResource MutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,13,0,0"/>
                <CheckBox x:Name="MinimizeCheck" Content="Minimize to notification area"/>
                <CheckBox x:Name="CloseCheck" Content="Close button hides to notification area"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
            <Button Content="Cancel" Style="{StaticResource ActionButton}" Width="100" Margin="0,0,9,0"
                    Click="Cancel_Click"/>
            <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Width="140"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
